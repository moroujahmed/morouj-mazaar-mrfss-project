{
  "name": "morouj-mazaar-mrfss",
  "version": "0.1.0",
  "private": true,
  "description": "Morouj Mazaar / MRFSS ordering, kitchen display, rider dispatch, and cash reconciliation system",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contrast": "vitest run tests/unit/contrast.test.ts",
    "test:tokens": "node scripts/check-tokens.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:db": "node tests/db/run-db-tests.mjs",
    "test:db:race": "node tests/db/claim-race.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:tokens && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "pg": "^8.23.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
