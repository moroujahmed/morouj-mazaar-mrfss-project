{
  "name": "morouj-mazaar-mrfss",
  "version": "1.5.0",
  "private": true,
  "description": "Morouj Mazaar / MRFSS ordering, kitchen display, rider dispatch, and cash reconciliation system",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contrast": "vitest run tests/unit/contrast.test.ts",
    "test:tokens": "node scripts/check-tokens.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:db": "node tests/db/run-db-tests.mjs",
    "test:db:race": "node tests/db/claim-race.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:tokens && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "pg": "^8.16.3",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  }
}
